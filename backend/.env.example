# ReSell AI Environment Configuration
# Copy this file to .env and fill in the values

# HuggingFace Token (Required for AI-generated image detection)
# Get one free at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token_here

# SerpAPI Key (Optional, for reverse image search)
# Get one at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_key_here

# Firebase Admin SDK credentials path
# FIREBASE_ADMIN_CREDENTIALS=path/to/serviceAccountKey.json

# --- SePay Payment ---
SEPAY_BANK_CODE=your_bank_code_here
SEPAY_ACCOUNT_NUMBER=your_account_number_here
SEPAY_ACCOUNT_HOLDER=your_account_holder_here
SEPAY_WEBHOOK_API_KEY=your_sepay_webhook_api_key_here
# Set to "true" in production to enforce SePay IP whitelist
SEPAY_ENFORCE_IP_WHITELIST=false

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Ngrok (auto-set by start-dev.ps1, do NOT set manually) ---
# NGROK_PUBLIC_URL is injected at runtime by start-dev.ps1
# It tells the backend its public webhook URL for logging purposes
