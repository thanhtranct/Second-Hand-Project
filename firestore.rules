rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Products — anyone can read, authenticated users can create
    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (request.auth.uid == resource.data.sellerId || isAdmin() || canBuyerMarkSold(productId));
    }

    // Users profile data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Wishlists — private to each user
    match /users/{userId}/wishlist/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Chat rooms
    match /chats/{chatId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId);
      allow create: if request.auth != null;
    }

    // Chat messages
    match /chats/{chatId}/messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }

    // Orders
    match /orders/{orderId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.sellerId || isAdmin());
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.sellerId || isAdmin() || canBuyerMarkOrderPaid());
    }

    // Seller Applications
    match /sellerApplications/{appId} {
      allow read: if request.auth != null && 
        (request.auth.uid == resource.data.userId || isAdmin());
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.userId;
      allow delete: if request.auth != null && request.auth.uid == resource.data.userId;
    }

    // Admin-only: all access
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // Helper function: check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.admin == true || 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin");
    }

    function canBuyerMarkOrderPaid() {
      return request.auth != null &&
        request.auth.uid == resource.data.buyerId &&
        resource.data.status == "pending" &&
        request.resource.data.status == "paid" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updatedAt", "paidAt"
        ]);
    }

    function canBuyerMarkSold(productId) {
      let orderId = request.resource.data.soldOrderId;
      return request.auth != null &&
        resource.data.status == "active" &&
        request.resource.data.status == "sold" &&
        orderId is string &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.buyerId == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.productId == productId &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.status == "paid" &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "soldOrderId", "soldAt", "updatedAt"
        ]);
    }
  }
}
